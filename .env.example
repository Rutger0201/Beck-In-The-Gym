# Local development: copy to .env at the workspace root.
# Next apps read the root .env through their next.config.ts.
NODE_ENV=development
SITE_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
PUBLICATION_APPROVED=false
# Use verified BITG details only. Empty channels are not shown.
CONTACT_EMAIL=
CONTACT_PHONE=
CONTACT_WHATSAPP=
CONTACT_INSTAGRAM=
CONTACT_FULL_NAME=Rutger
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_KVK=
LEGAL_VAT_ID=
BUSINESS_DETAILS_APPROVED=false
PRIVACY_CONTACT_EMAIL=
# PostgreSQL: web and admin must have separate roles. See docs/operations.md.
DATABASE_URL=postgresql://bitg_web:change-me@localhost:5432/bitg
ADMIN_DATABASE_URL=postgresql://bitg_admin:change-me@localhost:5432/bitg
MIGRATION_DATABASE_URL=postgresql://postgres:change-me@localhost:5432/bitg
BETTER_AUTH_SECRET=
RATE_LIMIT_SECRET=
JOBS_SECRET=
BREVO_API_KEY=
MAIL_FROM=
CONTACT_RECIPIENT_EMAIL=
# Set only after checking the analytics configuration and privacy statement.
ANALYTICS_APPROVED=false
GOATCOUNTER_CODE=
# Production ingress must overwrite X-Forwarded-For. Do not enable on an untrusted proxy.
TRUST_PROXY=false
# TLS certificate verification stays enabled. Set true if your provider requires SSL.
DATABASE_SSL=false
# Growth Pipeline (admin only, optional). See docs/growth.md. Without a key the pipeline uses rules and templates.
ANTHROPIC_API_KEY=
AI_MODEL=
BRAVE_SEARCH_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
