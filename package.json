{
  "name": "beck-in-the-gym",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "npm run dev --workspace=@bitg/web",
    "dev:admin": "npm run dev --workspace=@bitg/admin",
    "build": "npm run build --workspace=@bitg/web && npm run build --workspace=@bitg/admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test tests/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env --test tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "admin:create": "node --env-file-if-exists=.env scripts/create-owner.mjs",
    "release:check": "node --env-file-if-exists=.env scripts/release-check.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  }
}
